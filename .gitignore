# NativeUIAuditKit: only source, tests, package files and technical design or results documents go to the remote.
# Generated output (logs, eval reports, run outputs, datasets, caches, checkpoints) stays local.
# Local workflow files (AGENTS.md, Tasks.md, CompletedTasks.md, coordination records) are in .git/info/exclude.
# These rules do not remove tracked files or Git history.

# --- Build, editor and OS files ---
.build/
.work/
/.local-work/
xcuserdata/
*.hmap
*.ipa
*.dSYM
*.dSYM.zip
timeline.xctimeline
playground.xcworkspace
Carthage/Build/
fastlane/report.xml
fastlane/Preview.html
fastlane/screenshots/**/*.png
fastlane/test_output
.DS_Store
*.profraw
*.textClipping

# --- Python environments and caches (recreate a venv; never commit it) ---
/.venv-*/
__pycache__/
*.py[cod]
*$py.class

# --- Model weights, raw exports and training output ---
# Promoted compiled models (NativeUIAuditKitModels/.../Resources/*.mlmodelc) are tracked on purpose.
*.pt
*.pth
*.mlpackage/
NativeUIAuditKitModels/Sources/NativeUIAuditKitModels/*.mlpackage
NativeUIAuditKitModels/Sources/NativeUIAuditKitModels/*.mlpackage.mlmodel
runs/
# NativeUITrainer: only the trainer source goes remote. Logs, pids, locks, datasets and runs stay local.
/NativeUITrainer/*
!/NativeUITrainer/Sources/

# --- Datasets and captures ---
dataset/

# --- Local research records ---
/Research/Experiments/*
!/Research/Experiments/t46-recipes/
/Research/ExperimentLog.md
/Research/Focus366QueueHandoff.md
/Research/Generation354TTRReply.md
/Research/ResearchSpecs/*/

# --- Reports: generated output and local work ---
/reports/work/
/reports/coordination/
/reports/storage/README.md
/reports/storage/locations.json
/reports/research_dashboard.html
/reports/eval_*.txt
reports/eval_results*.json
reports/yolo_zeroshot/
reports/yolo_preds/
reports/yolo_gt/
reports/blurred_eval_images/
reports/real_world_screenshots/
reports/confusion_matrix_v*.png
reports/per_class_metrics_v*.csv
reports/centroid_bias_v*.json
/reports/visualizations/**/.browser-cache/
/reports/visualizations/**/.browser-profile/

# --- Old generated reports and one-off files (untracked 2026-11-25) ---
/reports/diagnose_*.txt
/reports/analyze_*.txt
/reports/*.cache
/reports/centroid_bias_*.json
/reports/holdout_diagnosis_*.json
/reports/phase6a_eval_summary.json
/reports/pytorch_reference_metrics.json
/reports/quantization_benchmark.json
/reports/spotcheck_*.json
/reports/batch_*_ingest.json
/reports/frame_similarity_threshold_derivation.json
/docs/*_debug.png
/ChatGPT Image *.png
# Third-party papers stay local: do not redistribute them in this public repository.
/Research/*.pdf
/CurrentBrainstorming.md
