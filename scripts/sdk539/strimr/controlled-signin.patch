diff --git a/Shared/Features/Jellyfin/Auth/JellyfinAuthenticationView.swift b/Shared/Features/Jellyfin/Auth/JellyfinAuthenticationView.swift
index de7c671..fd9cf77 100644
--- a/Shared/Features/Jellyfin/Auth/JellyfinAuthenticationView.swift
+++ b/Shared/Features/Jellyfin/Auth/JellyfinAuthenticationView.swift
@@ -10,6 +10,19 @@ struct JellyfinAuthenticationView: View {
     var body: some View {
         authenticationForm(viewModel)
             .onDisappear { viewModel.cancelQuickConnect() }
+            // NUIAK controlled build: sign in without text entry when the launch environment names a server and test user.
+            .task {
+                let env = ProcessInfo.processInfo.environment
+                guard let url = env["NUIAK_SERVER_URL"], !url.isEmpty else { return }
+                if viewModel.step == .server {
+                    viewModel.serverURL = url
+                    await viewModel.validateServer()
+                }
+                guard viewModel.step == .credentials, let user = env["NUIAK_USER"], let pass = env["NUIAK_PASSWORD"] else { return }
+                viewModel.username = user
+                viewModel.password = pass
+                await viewModel.signIn()
+            }
     }
 
     private func authenticationForm(_ viewModel: JellyfinAuthenticationViewModel) -> some View {
