diff --git a/Shared/Services/Keychain.swift b/Shared/Services/Keychain.swift
index 6010172..a58129b 100644
--- a/Shared/Services/Keychain.swift
+++ b/Shared/Services/Keychain.swift
@@ -14,6 +14,40 @@ extension Container {
 
     // TODO: take a look at all security options
     var keychainService: Factory<KeychainSwift> {
-        self { KeychainSwift() }.singleton
+        self { EntitlementFallbackKeychain() }.singleton
+    }
+}
+
+/// NUIAK controlled build: an unsigned Simulator build has no keychain entitlement (errSecMissingEntitlement, -34018).
+/// Only in that case, values go to app-local UserDefaults. A signed build uses the keychain unchanged.
+final class EntitlementFallbackKeychain: KeychainSwift {
+
+    private static let missingEntitlement: OSStatus = -34018
+    private let store = UserDefaults(suiteName: "nuiak.unsigned-keychain-fallback")!
+
+    override func set(_ value: Data, forKey key: String, withAccess access: KeychainSwiftAccessOptions? = nil) -> Bool {
+        if super.set(value, forKey: key, withAccess: access) { return true }
+        guard lastResultCode == Self.missingEntitlement else { return false }
+        store.set(value, forKey: key)
+        return true
+    }
+
+    override func getData(_ key: String, asReference: Bool = false) -> Data? {
+        if let data = super.getData(key, asReference: asReference) { return data }
+        return lastResultCode == Self.missingEntitlement ? store.data(forKey: key) : nil
+    }
+
+    override func delete(_ key: String) -> Bool {
+        let deleted = super.delete(key)
+        guard !deleted, lastResultCode == Self.missingEntitlement else { return deleted }
+        store.removeObject(forKey: key)
+        return true
+    }
+
+    override func clear() -> Bool {
+        let cleared = super.clear()
+        guard !cleared, lastResultCode == Self.missingEntitlement else { return cleared }
+        store.removePersistentDomain(forName: "nuiak.unsigned-keychain-fallback")
+        return true
     }
 }
