+// Controlled content changes data only. Existing app views remain in use.
+enum Real543Content {
+    static var enabled: Bool {
+        #if DEBUG
+        return ProcessInfo.processInfo.arguments.contains("--real543-controlled-content")
+        #else
+        return false
+        #endif
+    }
+    static let date = Date(timeIntervalSince1970: 1793232000)
+    static var articles: [NewsArticle] {
+        let categories: [NewsCategory] = [.topStories, .technology, .science]
+        return (0..<18).map { index in
+            let category = categories[index / 6]
+            let source = NewsSource(id: "real543", name: "Research Bulletin",
+                rssURL: URL(string: "https://example.invalid/feed")!, category: category)
+            return NewsArticle(id: UUID(uuidString: String(format: "54300000-0000-0000-0000-%012d", index))!,
+                title: "Community project update \(index + 1)", source: source,
+                url: URL(string: "https://example.invalid/article/\(index)")!,
+                publishedDate: date.addingTimeInterval(-Double(index * 600)), category: category,
+                rssDescription: "Volunteers review a local project and publish a progress report.",
+                summary: "This original research text supplies controlled content for UI evaluation.",
+                fullSummary: "The team records progress, reviews the plan, and prepares the next meeting.",
+                keyPoints: ["Review progress", "Prepare the next meeting"])
+        }
+    }
+}
