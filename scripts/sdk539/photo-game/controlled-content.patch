+
+
+// Controlled benchmark data does not change focus behavior or view layout.
+enum REAL543Content {
+    static var enabled: Bool {
+        #if DEBUG
+        ProcessInfo.processInfo.arguments.contains("--real543-controlled-content")
+        #else
+        false
+        #endif
+    }
+    static var calendar: Calendar {
+        guard enabled else { return Calendar.current }
+        var value = Calendar(identifier: .gregorian)
+        value.timeZone = TimeZone(secondsFromGMT: 0)!
+        value.locale = Locale(identifier: "en_US_POSIX")
+        return value
+    }
+    static func identifier(_ index: Int) -> UUID {
+        UUID(uuidString: String(format: "00000000-0000-4000-8000-%012d", index + 1))!
+    }
+    static func hue(_ id: UUID) -> Double {
+        // Swift hash values vary between processes. Use the stable suffix instead.
+        let index = Int(id.uuidString.suffix(12)) ?? 0
+        return Double((index * 37) % 360) / 360.0
+    }
+}
